TELEGRAM_BOT_TOKEN=tu_token_de_botfather
GROQ_API_KEY=
# Opcional: más cuentas Groq (coma). Misma org = misma cuota; cuentas distintas sí suman.
# GROQ_API_KEYS=gsk_otra1,gsk_otra2
# YouTube: solo audio, max ~280 MB (~5 h a 128 kbps; no bajar vídeo completo)
# Un vídeo de ~2 h (~110 MB opus) debe transcribirse (subtítulos auto o Whisper).
# MAX_YOUTUBE_DOWNLOAD_MB=280
# MAX_YOUTUBE_DURATION_SEC=18000
# TEMP_CLEANUP_MINUTES=180
# Velocidad (recomendado en Raspberry Pi; FAST_POLISH=1 activo por defecto en Linux):
# TRANSCRIBE_GROQ_ONLY=1
# RESTORE_SPANISH_ORTHO=0  (1 reescribe con Llama; puede inventar frases)
# WHISPER_USE_PROMPT=0     (prompt a Whisper sesga y alucina)
# GROQ_WHISPER_MODEL=whisper-large-v3
# TRANSCRIBE_PARALLEL_CHUNKS=4
# AUDIO_CHUNK_SEC=90
# (trozos largos comen tildes en español: habrá→habr; 60–90s va bien)
# FFMPEG_THREADS=1
# FAST_POLISH=1
# YTDLP_CONCURRENT_FRAGMENTS=4
# MAX_YOUTUBE_DOWNLOAD_MB=80
# Traducción: Groq (varios modelos) y si satura → Google/MyMemory gratis
# TRANSLATE_LLM_MODELS=openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-120b
# TRANSLATE_LLM_CHUNK_CHARS=2200
# TRANSLATE_CHUNK_PAUSE_SEC=2.0
HF_API_TOKEN=
# Solo Windows: edge, chrome o firefox. En Raspberry Pi dejar vacio y usar cookies.txt
# YTDLP_BROWSER=edge
# Tiempo max por enlace (segundos; vídeos largos: 3600+)
# YTDLP_JOB_TIMEOUT_SEC=3600
# YTDLP_SOCKET_TIMEOUT=60
# Opcional: token Telegraph (si no, se crea uno automático en telegraph_token.txt)
TELEGRAPH_ACCESS_TOKEN=
# Metadatos automáticos en exportaciones (título desde URL + descripción con Groq)
# METADATA_ENABLED=1
# DOCUMENT_TITLE=Transcripción
# METADATA_DESCRIPTION_MAX=320
# MP3 grande: subida externa (Litterbox/Catbox/GoFile/Pixeldrain, misma lógica que X Downloader)
# EXTERNAL_UPLOAD_ENABLED=1
# USER_MAX_EXTERNAL_PER_HOUR=4
# USER_MAX_EXTERNAL_PER_DAY=20
# UPLOAD_PROVIDERS=litterbox,catbox,gofile,pixeldrain
# EXPORT_TOC=1
# MAX_CHARS_FOR_TELEGRAM=4000
