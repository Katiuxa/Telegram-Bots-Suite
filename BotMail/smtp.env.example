# Copia a smtp.env y rellena (Mail.tm NO envia por API; esto es el relay SMTP).
# Brevo gratis: https://www.brevo.com/  -> SMTP y claves
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_email@ejemplo.com
SMTP_PASS=clave_smtp_de_brevo
# Opcional: remitente verificado en Brevo (si no, usa SMTP_USER)
# SMTP_FROM=notificaciones@tudominio.com
